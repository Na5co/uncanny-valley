# For the command line: copy to .env (git-ignored) and fill in the key.
# For `wrangler dev`, put the key in .dev.vars instead (also git-ignored). The deployed worker takes the key from
# `npx wrangler secret put DEEPSEEK_API_KEY` and its other settings from [vars] in wrangler.toml (docs/DEPLOY.md).
# Another OpenAI-compatible endpoint can work if it accepts (or ignores) response_format, seed and reasoning_effort.

# the API key, whatever the provider
DEEPSEEK_API_KEY=
# the same key under another name; read only when DEEPSEEK_API_KEY is not set at all (delete the line above to use it)
# VALLEY_LLM_API_KEY=

# the endpoint
VALLEY_LLM_BASE_URL=https://api.deepseek.com

# the model that writes towns and the story, and the model that plays the people; both need rates in config/prices.json
VALLEY_ARCHITECT_MODEL=deepseek-v4-pro
VALLEY_CITIZEN_MODEL=deepseek-flash

# hard stop for one command-line run, in USD at config/prices.json rates (default: spendCapUsdPerRun there)
VALLEY_SPEND_CAP_USD=2

# set to 1 to call a model config/prices.json has no price for (the spend cap then cannot see what it costs)
# VALLEY_ALLOW_UNPRICED=
