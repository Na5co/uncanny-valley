  "events": [
    {
      "id": "company-pitch",
      "at": 11,
      "jitterHours": 1,
      "chance": 1,
      "stakes": 1,
      "where": "quarry",
      "headline": "The company man shows the plan: forty jobs, ten years.",
      "text": "Glossy boards at the quarry gate. Real wages, he says, for people who have not had them in a decade.",
