      "stakes": 2,
      "where": "crown",
      "headline": "A lorry driver says the company's cheques bounce.",
      "text": "He hauled for them in Wales. He was not paid for the last two months.",
      "effects": {
        "belief": {
          "quarryWontPay": 0.5
        },
        "mood": -0.1
      }
    },
    {
      "id": "survey-leak",
      "at": 46,
      "jitterHours": 4,
      "chance": 0.6,
      "stakes": 2,
      "where": "crown",
      "headline": "A leaked survey says the hill is riddled with old workings.",
      "text": "Photocopied pages passed hand to hand. Voids under the north face, directly above the terraces.",
      "effects": {
        "belief": {
          "hillIsUnstable": 0.6
        },
        "mood": -0.1
      }
    },
    {
      "id": "county-letter",
