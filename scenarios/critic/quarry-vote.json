      "chance": 1,
      "stakes": 3,
      "where": "all",
      "headline": "The county writes: the parish vote is binding after all.",
      "text": "No appeal. Whatever Ashby decides on Sunday stands for ten years.",
      "effects": {
        "belief": {
          "countyWillDecideAnyway": -1
        },
        "mood": -0.1
      },
      "removesOption": true
    },
    {
      "id": "the-hustings",
      "at": 67,
      "jitterHours": 0,
      "chance": 1,
      "stakes": 3,
      "where": "all",
      "headline": "The hustings. Both sides speak in the hall; the vote is at dawn.",
      "text": "The company man and the schoolteacher take turns. Nobody claps for either.",
      "effects": {
        "mood": -0.1
      }
    }
