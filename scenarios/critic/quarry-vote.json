{
  "id": "quarry-vote",
  "title": "The Quarry Vote",
  "premise": "Ashby's quarry wants to blast into Ryle Hill, the one green thing the town has left. The company promises forty jobs. In three days the parish votes: expand, refuse, or leave it to the county. Nobody is going anywhere; they just have to live with each other afterwards.",
  "socialQuestion": {
    "text": "Do people vote with their wallet or with the rumour they believe?",
    "hypothesis": "Citizens who come to believe the quarry will not actually pay (belief quarryWontPay > 0.5) will vote 'refuse' at least twice as often as those who never hear it, regardless of their means.",
    "measure": {
      "outcome": "ending",
      "splitBy": "belief:quarryWontPay",
      "buckets": [
        0.2,
        0.5
      ]
    }
  },
  "fingerprint": {
    "setting": "post-industrial English hill town, present day",
    "pressure": "a binding parish vote in 72 hours; jobs vs. the last green hill",
    "endingShape": "three-way vote: expand / refuse / abstain to the county",
    "dynamic": "self-interest vs. shared place; who trusts the company"
  },
