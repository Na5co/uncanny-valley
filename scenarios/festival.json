      "stakes": 3,
      "where": "all",
      "headline": "The last night. The wagons are hitched at dawn.",
      "text": "The ringmaster closes the book. Names are taken tonight or never.",
      "removesOption": true,
      "fx": "aurora",
      "fxHours": 4
    }
