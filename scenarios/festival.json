      "chance": 1,
      "stakes": 2,
      "where": "all",
      "headline": "A night storm flattens the smaller tents.",
      "text": "Everyone who can lift a pole is in the mud together until dawn.",
      "effects": {
        "mood": -0.2
      },
      "fx": "storm",
      "fxHours": 6
