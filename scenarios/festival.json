{
  "id": "festival",
  "title": "Three Nights at Kell Fair",
  "premise": "A travelling fair pitches on the common of a small farming town for three nights. Fair folk and townspeople share one square. When the tents come down, some will leave with the fair, some will go home, and some will not go back to the life they had.",
  "socialQuestion": {
    "text": "Does a rumour introduced late change more minds than one introduced early?",
    "hypothesis": "Citizens exposed to the late rumour (hour ~55) end up with a final choice different from their hour-0 lean more often than citizens who were not.",
    "measure": {
      "outcome": "changedMind",
      "splitBy": "exposedTo:late-rumour"
    }
  },
  "fingerprint": {
    "setting": "travelling fair on a farm-town common, three nights",
    "pressure": "the fair leaves at dawn on the fourth day; a once-only invitation",
    "endingShape": "three-way: go with the fair / go home / stay but changed",
    "dynamic": "strangers vs. neighbours; novelty vs. belonging"
  },
